<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="category_view_form" model="ir.ui.view">
        <field name="name">category.view.form</field>
        <field name="model">upmin_stock.category</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="category" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="category_view_tree" model="ir.ui.view">
        <field name="name">category.view.tree</field>
        <field name="model">upmin_stock.category</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="category" />
            </tree>
        </field>
    </record>

    <record id="category_action" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">upmin_stock.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="category_menu"
        name="Category"
        action="category_action"
        parent="configuration_menu"
        sequence="10"/>

</odoo>
