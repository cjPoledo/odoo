<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="replenishment_view_tree" model="ir.ui.view">
        <field name="name">replenishment.view.tree</field>
        <field name="model">upmin_stock.replenishment</field>
        <field name="arch" type="xml" >
            <tree string="" create="false" delete="false" default_order="date desc" >
                <field name="date" />
                <field name="stock_id" />
                <field name="quantity" />
                <field name="notes" />
            </tree>
        </field>
    </record>

    <record id="replenishment_action" model="ir.actions.act_window">
        <field name="name">Replenishment Logs</field>
        <field name="res_model">upmin_stock.replenishment</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="replenishment_menu"
        name="Replenishment Logs"
        action="replenishment_action"
        parent="logs_menu"
        sequence="10"/>

</odoo>
