<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rc_view_form" model="ir.ui.view">
        <field name="name">rc.view.form</field>
        <field name="model">upmin_stock.rc</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="rc_code" />
                        <field name="rc_name" />
                        <field name="members" widget="many2many_tags"
                            options="{'no_create': True}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rc_view_tree" model="ir.ui.view">
        <field name="name">rc.view.tree</field>
        <field name="model">upmin_stock.rc</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="rc_code" />
                <field name="rc_name" />
            </tree>
        </field>
    </record>

    <record id="rc_action" model="ir.actions.act_window">
        <field name="name">Responsibility Center</field>
        <field name="res_model">upmin_stock.rc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="rc_menu"
        name="Responsibility Center"
        action="rc_action"
        parent="configuration_menu"
        sequence="10" />

</odoo>