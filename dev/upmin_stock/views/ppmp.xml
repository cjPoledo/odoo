<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ppmp_balance_view_form" model="ir.ui.view">
        <field name="name">ppmp_balance.view.form</field>
        <field name="model">upmin_stock.ppmp_balance</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="stock_id" />
                        <field name="spmo_balance" />
                        <field name="initial_balance" />
                        <field name="total_issued" />
                        <field name="ppmp_balance" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ppmp_view_tree" model="ir.ui.view">
        <field name="name">ppmp.view.tree</field>
        <field name="model">upmin_stock.ppmp</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="rc" />
                <field name="fund_cluster_id" />
                <field name="ppmp_balance_lines" />
            </tree>
        </field>
    </record>

    <record id="ppmp_view_form" model="ir.ui.view">
        <field name="name">ppmp.view.form</field>
        <field name="model">upmin_stock.ppmp</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="rc" attrs="{'readonly': [('id', '!=', False)]}" />
                        </group>
                        <group>
                            <field name="fund_cluster_id"
                                attrs="{'readonly': [('id', '!=', False)]}" />
                        </group>
                        <field name="ppmp_balance_lines">
                            <tree editable="bottom">
                                <field name="stock_id" />
                                <field name="spmo_balance" />
                                <field name="initial_balance" />
                                <field name="total_issued" />
                                <field name="ppmp_balance" />
                            </tree>
                        </field>
                    </group>
                </sheet>

                <notebook groups="upmin_stock.group_spmo_stock_custodian">
                    <page string="Related Issuances">
                        <div class="oe_form_box" style="padding: 0 20px;">
                            <field name="related_issuances" readonly="1">
                                <tree string="Related Issuances">
                                    <field name="seq_no" string="Seq.no" />
                                    <field name="date_issued" />
                                    <field name="requested_by" />
                                    <field name="ris_no" string="RIS#" />
                                    <field name="office" string="Office/Dept" />
                                    <field name="rc_code" />
                                    <field name="remarks" />
                                    <field name="stock_no_id" />
                                    <field name="stock_desc" string="Description" />
                                    <field name="unit" />
                                    <field name="quantity_requested" string="Qty Requested" />
                                    <field name="balance" />
                                    <field name="quantity_issued" string="Qty Issued" />
                                    <field name="fund_cluster" />
                                </tree>
                            </field>
                        </div>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="ppmp_action" model="ir.actions.act_window">
        <field name="name">Project Procurement Management Plan</field>
        <field name="res_model">upmin_stock.ppmp</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="ppmp_menu"
        name="PPMP"
        action="ppmp_action"
        parent="upmin_stock_menu"
        sequence="54" />

</odoo>