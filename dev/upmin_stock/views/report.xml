<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_view_kanban" model="ir.ui.view">
        <field name="name">report.view.kanban</field>
        <field name="model">upmin_stock.report</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_card" style="width: 100%; padding: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); border-radius: 10px; background: white;">
                            <div class="o_kanban_stat_box" style="display: flex; justify-content: space-around; text-align: center;">
                                <div style="padding: 0px 10px;">
                                    <div style="font-weight: bold; font-size: 16px;">Total Quantity</div>
                                    <div style="font-size: 24px; color: #007bff;"><field name="total_quantity"/></div>
                                </div>
                                <div style="padding: 0px 10px;">
                                    <div style="font-weight: bold; font-size: 16px;">Total Issued</div>
                                    <div style="font-size: 24px; color: #28a745;"><field name="total_issued"/></div>
                                </div>
                                <div style="padding: 0px 10px;">
                                    <div style="font-weight: bold; font-size: 16px;">Total Balance</div>
                                    <div style="font-size: 24px; color: #ffc107;"><field name="total_balance"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_report" model="ir.actions.act_window">
        <field name="name">Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upmin_stock.report</field>
        <field name="view_mode">kanban</field>
    </record>
    <menuitem
        id="upmin_stock_report"
        name="Report"
        parent="upmin_stock_menu"
        action="action_report"
        sequence="15"/>
</odoo>
