<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_view_form" model="ir.ui.view">
        <field name="name">stock.view.form</field>
        <field name="model">upmin_stock.stock</field>
        <field name="arch" type="xml">
            <form string="Stock">
                <header>
                    <div class="bg-light border rounded my-1 px-3 py-1" style="font-size: 1.1em;">
                        <strong class="me-2 text-muted">Running Balance:</strong>
                        <field name="initial_balance" readonly="1" class="me-1 fw-bold text-primary"/>
                        <field name="unit" readonly="1" options="{'no_open': True}" class="text-primary"/>
                    </div>
                    <div class="bg-light border rounded my-1 px-3 py-1" style="font-size: 1.1em;">
                        <strong class="me-2 text-muted">Current Balance:</strong>
                        <field name="balance" readonly="1" class="me-1 fw-bold text-primary"/>
                        <field name="unit" readonly="1" options="{'no_open': True}" class="text-primary"/>
                    </div>
                    <button name="action_replenish_stock"
                            type="object"
                            string="Replenish Stock"
                            class="btn-primary mx-2"
                            icon="fa-plus-circle"/>
                </header>
                <sheet>
                    <group>
                        <field name="stock_no" />
                        <field name="description" />
                        <field name="unit" />
                        <field name="price" />
                        <field name="psdbm_price" />
                        <field name="category" />
                    </group>
                </sheet>

                <notebook>
                    <page string="Related Issuances">
                        <div class="oe_form_box" style="padding: 0 20px;">
                            <field name="issuance_ids" readonly="1" >
                                <tree string="Related Issuances">
                                    <field name="seq_no" />
                                    <field name="date_issued" />
                                    <field name="requested_by" />
                                    <field name="ris_no" />
                                    <field name="rc_code" />
                                    <field name="remarks" />
                                    <field name="stock_no" />
                                    <field name="quantity_requested" />
                                    <field name="quantity_issued" />
                                </tree>
                            </field>
                        </div>
                    </page>
                    <page string="Replenishment History">
                        <div class="oe_form_box" style="padding: 0 20px;">
                            <field name="replenishment_ids" readonly="1" >
                                <tree default_order="date desc" string="Replenishment History">
                                    <field name="date" />
                                    <field name="quantity" />
                                    <field name="notes" />
                                </tree>
                            </field>
                        </div>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="stock_replenishment_view_form" model="ir.ui.view">
        <field name="name">stock_replenishment.view.form</field>
        <field name="model">upmin_stock.replenishment</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="quantity" />
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_view_tree" model="ir.ui.view">
        <field name="name">stock.view.tree</field>
        <field name="model">upmin_stock.stock</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="stock_no" />
                <field name="description" />
                <field name="unit" />
                <field name="initial_balance" />
                <field name="balance" />
                <field name="price" />
                <field name="psdbm_price" />
                <field name="category" />
            </tree>
        </field>
    </record>

    <record id="stock_view_kanban" model="ir.ui.view">
        <field name="name">stock.view.kanban</field>
        <field name="model">upmin_stock.stock</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_details oe_kanban_global_click">
                            <strong>
                                <field name="description" />
                            </strong>
                            <div>
                                [<field name="stock_no" />]
                            </div>
                            <div>
                                Price: <field name="price" />
                            </div>
                            <div>
                                Balance: <field name="balance" /> <field name="unit" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="stock_view_search" model="ir.ui.view">
        <field name="name">stock.view.search</field>
        <field name="model">upmin_stock.stock</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="description" />
                <field name="stock_no" />
            </search>
        </field>
    </record>

    <record id="action_stock" model="ir.actions.act_window">
        <field name="name">Stock</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upmin_stock.stock</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem
        id="upmin_stock_stock"
        name="Stock"
        parent="upmin_stock_menu"
        action="action_stock"
        sequence="20"/>
</odoo>
