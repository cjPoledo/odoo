<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_view_form" model="ir.ui.view">
        <field name="name">stock.view.form</field>
        <field name="model">upmin_stock.stock</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="stock_no" />
                        <field name="description" />
                        <field name="unit" />
                        <field name="initial_balance" />
                        <field name="price" />
                        <field name="psdbm_price" />
                        <field name="category" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_view_tree" model="ir.ui.view">
        <field name="name">stock.view.tree</field>
        <field name="model">upmin_stock.stock</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="stock_no" />
                <field name="description" />
                <field name="unit" />
                <field name="initial_balance" />
                <field name="price" />
                <field name="psdbm_price" />
                <field name="category" />
            </tree>
        </field>
    </record>

    <record id="action_stock" model="ir.actions.act_window">
        <field name="name">Stock</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upmin_stock.stock</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="upmin_stock_stock"
        name="Stock"
        parent="upmin_stock_menu"
        action="action_stock"
        sequence="10"/>
</odoo>
