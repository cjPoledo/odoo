<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ris_view_tree" model="ir.ui.view">
        <field name="name">ris.view.tree</field>
        <field name="model">upmin_stock.ris</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="ris_no" />
                <field name="status" />
                <field name="entity_name" />
                <field name="fund_cluster" />
                <field name="rc_code" />
                <field name="requested_by" />
            </tree>
        </field>
    </record>

    <record id="ris_view_form" model="ir.ui.view">
        <field name="name">ris.view.form</field>
        <field name="model">upmin_stock.ris</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="ris_no" style="font-size:2em"
                                attrs="{'invisible': [('ris_no','=',False)]}" required="0" />
                        </group>
                        <group>
                            <field name="status" style="font-size:1.5em"
                                attrs="{'invisible': [('ris_no','=',False)]}" />
                        </group>
                        <group>
                            <field name="entity_name" />
                            <field name="division" />
                        </group>
                        <group>
                            <field name="fund_cluster" />
                            <field name="rc_code" />
                        </group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="stock_id" />
                                <field name="stock_balance" readonly="1" />
                                <field name="quantity_req" />
                                <field name="stock_avail"
                                    groups="upmin_stock.group_spmo_stock_custodian" />
                                <field name="quantity_issued"
                                    groups="upmin_stock.group_spmo_stock_custodian"
                                    attrs="{'readonly': [('stock_avail','=',False)]}" />
                                <field name="remarks"
                                    groups="upmin_stock.group_spmo_stock_custodian" />
                            </tree>
                        </field>
                        <label for="purpose" class="fw-bold" />
                        <field name="purpose" />
                        <group>
                            <field name="requested_by" />
                            <field name="requester_designation" />
                            <field name="request_date" />
                        </group>
                        <group>
                            <field name="approved_by" />
                            <field name="approver_designation" />
                            <field name="approve_date" />
                        </group>
                        <group>
                            <field name="user_has_permission" invisible="1" />
                            <field name="issued_by"
                                attrs="{'readonly': [('user_has_permission', '=', False)]}" />
                            <field name="issuer_designation"
                                attrs="{'readonly': [('user_has_permission', '=', False)]}" />
                            <field name="issue_date"
                                attrs="{'readonly': [('user_has_permission', '=', False)]}" />
                        </group>
                        <group>
                            <field name="received_by"
                                attrs="{'readonly': [('issued_by', '=', False)]}" />
                            <field name="receiver_designation"
                                attrs="{'readonly': [('issued_by', '=', False)]}" />
                            <field name="receive_date"
                                attrs="{'readonly': [('issued_by', '=', False)]}" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ris" model="ir.actions.act_window">
        <field name="name">Requisition and Issue Slip</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upmin_stock.ris</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="ris_menu"
        name="RIS"
        action="action_ris"
        parent="upmin_stock_menu"
        sequence="30" />
</odoo>