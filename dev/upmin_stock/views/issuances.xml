<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="issuances_view_tree" model="ir.ui.view">
        <field name="name">issuances.view.tree</field>
        <field name="model">upmin_stock.issuance</field>
        <field name="arch" type="xml">
            <tree string="" create="false" delete="false" edit="false">
                <field name="seq_no" string="Seq.no" />
                <field name="date_issued" />
                <field name="requested_by" />
                <field name="ris_no" string="RIS#" />
                <field name="office" string="Office/Dept" />
                <field name="rc_code" />
                <field name="remarks" />
                <field name="stock_no_id" />
                <field name="stock_desc" string="Description" />
                <field name="unit" />
                <field name="quantity_requested" string="Qty Requested" />
                <field name="balance" />
                <field name="quantity_issued" string="Qty Issued" />
                <field name="fund_cluster" />
            </tree>
        </field>
    </record>

    <record id="issuances_view_search" model="ir.ui.view">
        <field name="name">issuances.view.search</field>
        <field name="model">upmin_stock.issuance</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="seq_no" />
                <field name="requested_by" />
                <field name="ris_no" />
                <field name="rc_code" />
                <field name="stock_no" />
            </search>
        </field>
    </record>

    <record id="action_issuances" model="ir.actions.act_window">
        <field name="name">Issuances</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upmin_stock.issuance</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem
        id="upmin_stock_issuances"
        name="Issuances"
        parent="upmin_stock_menu"
        action="action_issuances"
        sequence="25"
        groups="upmin_stock.group_spmo_stock_custodian" />
</odoo>