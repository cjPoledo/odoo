<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_fund_balance_view_tree" model="ir.ui.view">
        <field name="name">stock_fund_balance.view.tree</field>
        <field name="model">upmin_stock.stock_fund_balance</field>
        <field name="arch" type="xml">
            <tree string="" create="false" delete="false" edit="false">
                <field name="stock_id" />
                <field name="fund_cluster_id" />
                <field name="balance" />
            </tree>
        </field>
    </record>

    <record id="stock_fund_balance_action" model="ir.actions.act_window">
        <field name="name">Stock Balance</field>
        <field name="res_model">upmin_stock.stock_fund_balance</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="stock_fund_balance_menu"
        name="Stock Fund Balance"
        action="stock_fund_balance_action"
        parent="logs_menu"
        sequence="15"
        groups="upmin_stock.group_spmo_stock_custodian" />

</odoo>