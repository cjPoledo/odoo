<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rsmi_view_form" model="ir.ui.view">
        <field name="name">rsmi.view.form</field>
        <field name="model">upmin_stock.rsmi</field>
        <field name="arch" type="xml">
            <form string="rsmi">
                <header>
                    <div class="oe_button_box">
                        <button name="%(action_report_rsmi)d" type="action"
                            string="Print"
                            class="btn-secondary" />
                    </div>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="entity_name" />
                            <field name="fund_cluster" />
                        </group>
                        <group>
                            <field name="serial_no" />
                            <field name="date" />
                        </group>
                        <field name="issuances" />
                    </group>
                    <group>
                        <group>
                            <field name="supply_custodian" />
                        </group>
                        <group>
                            <field name="accounting_staff" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rsmi_view_tree" model="ir.ui.view">
        <field name="name">rsmi.view.tree</field>
        <field name="model">upmin_stock.rsmi</field>
        <field name="arch" type="xml">
            <tree string="rsmi">
                <field name="serial_no" />
                <field name="entity_name" />
                <field name="fund_cluster" />
                <field name="date" />
                <field name="issuances" />
                <field name="supply_custodian" />
                <field name="accounting_staff" />
            </tree>
        </field>
    </record>

    <record id="rsmi_action" model="ir.actions.act_window">
        <field name="name">Report of Supplies and Materials Issued</field>
        <field name="res_model">upmin_stock.rsmi</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="rsmi_menu"
        name="RSMI"
        action="rsmi_action"
        parent="upmin_stock_report"
        sequence="15" />

</odoo>