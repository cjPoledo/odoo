<odoo>
    <data noupdate="0">

        <record id="rule_ppmp_access_user" model="ir.rule">
            <field name="name">PPMP - User Access (via access_list)</field>
            <field name="model_id" ref="model_upmin_stock_ppmp" />
            <field name="groups" eval="[(4, ref('upmin_stock.group_spmo_stock_user'))]" />
            <field name="domain_force">[('rc.members', 'in', user.partner_id.id)]</field>
        </record>

        <record id="rule_ppmp_access_custodian" model="ir.rule">
            <field name="name">PPMP - Custodian Access (all records)</field>
            <field name="model_id" ref="model_upmin_stock_ppmp" />
            <field name="groups" eval="[(4, ref('upmin_stock.group_spmo_stock_custodian'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_ris_access_user" model="ir.rule">
            <field name="name">RIS - User Access (via access_list)</field>
            <field name="model_id" ref="model_upmin_stock_ris" />
            <field name="groups" eval="[(4, ref('upmin_stock.group_spmo_stock_user'))]" />
            <field name="domain_force">[('rc_code.members', 'in', user.partner_id.id)]</field>
        </record>

        <record id="rule_ris_access_custodian" model="ir.rule">
            <field name="name">RIS - Custodian Access</field>
            <field name="model_id" ref="model_upmin_stock_ris" />
            <field name="groups" eval="[(4, ref('upmin_stock.group_spmo_stock_custodian'))]" />
            <field name="domain_force">['|', ('status', '!=', 'draft'), ('create_uid', '=',
                user.id)]</field>
        </record>

    </data>
</odoo>