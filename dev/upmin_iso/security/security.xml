<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_iso" model="ir.module.category">
        <field name="name">UPMin ISO</field>
        <field name="description">Groups related to ISO Module</field>
    </record>

    <record id="group_iso_doc_controller" model="res.groups">
        <field name="name">ISO Document Controller</field>
        <field name="category_id" ref="module_category_iso" />
    </record>

    <record id="group_iso_internal_auditor" model="res.groups">
        <field name="name">ISO Internal Auditor</field>
        <field name="category_id" ref="module_category_iso" />
    </record>

    <record id="group_iso_staff" model="res.groups">
        <field name="name">ISO Staff</field>
        <field name="category_id" ref="module_category_iso" />
    </record>

    <record id="rule_office_ror" model="ir.rule">
        <field name="name">Restrict ROR Access to Own Office</field>
        <field name="model_id" ref="model_upmin_iso_ror" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">[('office', '=', user.employee_id.department_id.id)]</field>
    </record>

    <record id="rule_audit_info_doc_controller" model="ir.rule">
        <field name="name">Doc Controller: See Audit Info of Own Office</field>
        <field name="model_id" ref="model_upmin_iso_audit_info" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">[('office_to_audit.doc_controllers', 'in', user.partner_id.id)]</field>
    </record>

    <record id="rule_audit_info_internal_auditor" model="ir.rule">
        <field name="name">Internal Auditor: See Audit Info Where Internal Auditor</field>
        <field name="model_id" ref="model_upmin_iso_audit_info" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">[('internal_auditors', 'in', user.partner_id.id)]</field>
    </record>

    <record id="rule_swot_doc_controller_own" model="ir.rule">
        <field name="name">Doc Controller: CRUD Own Office SWOT</field>
        <field name="model_id" ref="model_upmin_iso_swot" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">[('office', '=', user.employee_id.department_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="rule_swot_iso_staff_readall" model="ir.rule">
        <field name="name">ISO Staff: Read All SWOT</field>
        <field name="model_id" ref="model_upmin_iso_swot" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="rule_tows_doc_controller_own" model="ir.rule">
        <field name="name">Doc Controller: CRUD Own Office TOWS</field>
        <field name="model_id" ref="model_upmin_iso_tows" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">[('office', '=', user.employee_id.department_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="rule_tows_iso_staff_readall" model="ir.rule">
        <field name="name">ISO Staff: Read All TOWS</field>
        <field name="model_id" ref="model_upmin_iso_tows" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>