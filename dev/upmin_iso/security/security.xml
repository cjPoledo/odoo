<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_iso" model="ir.module.category">
        <field name="name">UPMin ISO</field>
        <field name="description">Groups related to ISO Module</field>
    </record>

    <record id="group_iso_doc_controller" model="res.groups">
        <field name="name">ISO Document Controller</field>
        <field name="category_id" ref="module_category_iso" />
    </record>

    <record id="group_iso_internal_auditor" model="res.groups">
        <field name="name">ISO Internal Auditor</field>
        <field name="category_id" ref="module_category_iso" />
    </record>

    <record id="group_iso_staff" model="res.groups">
        <field name="name">ISO Staff</field>
        <field name="category_id" ref="module_category_iso" />
    </record>

    <record id="rule_office_ror" model="ir.rule">
        <field name="name">Restrict ROR Access to Own Office</field>
        <field name="model_id" ref="model_upmin_iso_ror" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', ('office', '=', user.employee_id.department_id.id), ('office', '=', user.employee_id.admin_department_id.id)]</field>
    </record>

    <record id="rule_office_ror_staff" model="ir.rule">
        <field name="name">Access ROR: Staff Read All</field>
        <field name="model_id" ref="model_upmin_iso_ror" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_audit_info_doc_controller" model="ir.rule">
        <field name="name">Doc Controller: See Audit Info of Own Office</field>
        <field name="model_id" ref="model_upmin_iso_audit_info" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', ('office_to_audit', '=', user.employee_id.department_id.id), ('office_to_audit', '=', user.employee_id.admin_department_id.id)]</field>
    </record>


    <record id="rule_audit_info_internal_auditor" model="ir.rule">
        <field name="name">Internal Auditor: See Audit Info Where Internal Auditor</field>
        <field name="model_id" ref="model_upmin_iso_audit_info" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">[('internal_auditors.name.user_id', '=', user.id)]</field>
    </record>

    <!-- <record id="rule_audit_info_access" model="ir.rule">
        <field name="name">Access Audit Info</field>
        <field name="model_id" ref="model_upmin_iso_audit_info" />
        <field name="groups"
            eval="[(4, ref('upmin_iso.group_iso_doc_controller')),(4,
    ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">['|',('office_to_audit', '=',
            user.employee_id.department_id.id),('internal_auditors.name.user_id', '=', user.id)]</field>
    </record> -->

    <record id="rule_audit_info_staff_full" model="ir.rule">
        <field name="name">Access Audit Info: Staff Full Access</field>
        <field name="model_id" ref="model_upmin_iso_audit_info" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record id="rule_swot_doc_controller_own" model="ir.rule">
        <field name="name">Doc Controller: CRUD Own Office SWOT</field>
        <field name="model_id" ref="model_upmin_iso_swot" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', ('office', '=', user.employee_id.department_id.id), ('office', '=', user.employee_id.admin_department_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="rule_swot_iso_staff_readall" model="ir.rule">
        <field name="name">ISO Staff: Read All SWOT</field>
        <field name="model_id" ref="model_upmin_iso_swot" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="rule_tows_doc_controller_own" model="ir.rule">
        <field name="name">Doc Controller: CRUD Own Office TOWS</field>
        <field name="model_id" ref="model_upmin_iso_tows" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', ('office', '=', user.employee_id.department_id.id), ('office', '=', user.employee_id.admin_department_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="rule_tows_iso_staff_readall" model="ir.rule">
        <field name="name">ISO Staff: Read All TOWS</field>
        <field name="model_id" ref="model_upmin_iso_tows" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="rule_iso_staff_all" model="ir.rule">
        <field name="name">ISO Staff - Full Read</field>
        <field name="model_id" ref="model_upmin_iso_ccar" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="rule_doc_controller_read" model="ir.rule">
        <field name="name">Doc Controller - Read Own Office</field>
        <field name="model_id" ref="model_upmin_iso_ccar" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', ('office', '=', user.employee_id.department_id.id), ('office', '=', user.employee_id.admin_department_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
    </record>

    <record id="rule_doc_controller_write_office" model="ir.rule">
        <field name="name">Doc Controller - Write Office Status</field>
        <field name="model_id" ref="model_upmin_iso_ccar" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['&amp;', '|', ('office', '=', user.employee_id.department_id.id), ('office', '=', user.employee_id.admin_department_id.id), ('status', 'in', ('office', 'office2'))]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
    </record>

    <record id="rule_internal_auditor_read" model="ir.rule">
        <field name="name">Internal Auditor - Read Assigned</field>
        <field name="model_id" ref="model_upmin_iso_ccar" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">
            [
            ('auditors.name.user_id', '=', user.id)
            ]
        </field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
    </record>

    <record id="rule_internal_auditor_write" model="ir.rule">
        <field name="name">Internal Auditor - Write Creation and Verification</field>
        <field name="model_id" ref="model_upmin_iso_ccar" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">
            [
            ('auditors.name.user_id', '=', user.id),
            ('status', 'in', ('creation', 'verification'))
            ]
        </field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
    </record>


    <record id="rule_document_controller_staff_all" model="ir.rule">
        <field name="name">Document Controller: Staff See All</field>
        <field name="model_id" ref="model_upmin_iso_document_controller" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
    </record>

    <record id="rule_document_controller_general_trained_only" model="ir.rule">
        <field name="name">Document Controller: Non-Staff See Trained Only</field>
        <field name="model_id" ref="model_upmin_iso_document_controller" />
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('trained', '=', True)]</field>
        <field name="perm_read" eval="1" />
    </record>

    <!-- ROR Rating: Staff read all -->
    <record id="rule_ror_rating_staff" model="ir.rule">
        <field name="name">ISO Staff: ROR Rating Read All</field>
        <field name="model_id" ref="model_upmin_iso_ror_rating" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- ROR Rating: DC restricted to own office (via issue → ror/swot → office) -->
    <record id="rule_ror_rating_doc_controller" model="ir.rule">
        <field name="name">Doc Controller: ROR Rating Own Office Only</field>
        <field name="model_id" ref="model_upmin_iso_ror_rating" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', '|', '|',
            ('issue.ror_id.office', '=', user.employee_id.department_id.id),
            ('issue.ror_id.office', '=', user.employee_id.admin_department_id.id),
            ('issue.swot_id.office', '=', user.employee_id.department_id.id),
            ('issue.swot_id.office', '=', user.employee_id.admin_department_id.id)]</field>
    </record>

    <!-- Audit Finding: Staff read all -->
    <record id="rule_audit_finding_staff" model="ir.rule">
        <field name="name">ISO Staff: Audit Finding Read All</field>
        <field name="model_id" ref="model_upmin_iso_audit_finding" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- Audit Finding: IA restricted to assigned audit_infos -->
    <record id="rule_audit_finding_internal_auditor" model="ir.rule">
        <field name="name">Internal Auditor: Audit Finding Assigned Only</field>
        <field name="model_id" ref="model_upmin_iso_audit_finding" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">[('audit_info.internal_auditors.name.user_id', '=', user.id)]</field>
    </record>

    <!-- CCAR Corrective Action: Staff read all -->
    <record id="rule_ccar_corrective_action_staff" model="ir.rule">
        <field name="name">ISO Staff: CCAR Corrective Action Read All</field>
        <field name="model_id" ref="model_upmin_iso_ccar_corrective_action" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- CCAR Corrective Action: DC own office, IA assigned only -->
    <record id="rule_ccar_corrective_action_doc_controller" model="ir.rule">
        <field name="name">Doc Controller: CCAR Corrective Action Own Office</field>
        <field name="model_id" ref="model_upmin_iso_ccar_corrective_action" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_doc_controller'))]" />
        <field name="domain_force">['|', ('ccar.office', '=', user.employee_id.department_id.id), ('ccar.office', '=', user.employee_id.admin_department_id.id)]</field>
    </record>

    <record id="rule_ccar_corrective_action_internal_auditor" model="ir.rule">
        <field name="name">Internal Auditor: CCAR Corrective Action Assigned Only</field>
        <field name="model_id" ref="model_upmin_iso_ccar_corrective_action" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">[('ccar.auditors.name.user_id', '=', user.id)]</field>
    </record>

    <!-- CCAR Effectiveness: Staff read all -->
    <record id="rule_ccar_correction_effectiveness_staff" model="ir.rule">
        <field name="name">ISO Staff: Correction Effectiveness Read All</field>
        <field name="model_id" ref="model_upmin_iso_ccar_correction_effectiveness" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_ccar_corrective_action_effectiveness_staff" model="ir.rule">
        <field name="name">ISO Staff: Corrective Action Effectiveness Read All</field>
        <field name="model_id" ref="model_upmin_iso_ccar_corrective_action_effectiveness" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_staff'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- CCAR Effectiveness: IA restricted to assigned CCARs -->
    <record id="rule_ccar_correction_effectiveness_internal_auditor" model="ir.rule">
        <field name="name">Internal Auditor: Correction Effectiveness Assigned Only</field>
        <field name="model_id" ref="model_upmin_iso_ccar_correction_effectiveness" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">[('ccar.auditors.name.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_ccar_corrective_action_effectiveness_internal_auditor" model="ir.rule">
        <field name="name">Internal Auditor: Corrective Action Effectiveness Assigned Only</field>
        <field name="model_id" ref="model_upmin_iso_ccar_corrective_action_effectiveness" />
        <field name="groups" eval="[(4, ref('upmin_iso.group_iso_internal_auditor'))]" />
        <field name="domain_force">[('ccar.auditors.name.user_id', '=', user.id)]</field>
    </record>

</odoo>