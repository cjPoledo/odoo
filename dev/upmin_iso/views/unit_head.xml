<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.unit_head_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.unit_head.view.form</field>
        <field name="model">upmin_iso.unit_head</field>
        <field name="arch" type="xml">
            <form string="" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="email" widget="email" />
                        <field name="office" widget="many2many_tags" />
                        <field name="perms_label" widget="badge"
                            decoration-success="perms_label == 'active'"
                            decoration-danger="perms_label == 'inactive'"
                            groups="upmin_iso.group_iso_staff" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.unit_head_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.unit_head.view.tree</field>
        <field name="model">upmin_iso.unit_head</field>
        <field name="arch" type="xml">
            <tree string="" create="0" edit="0" delete="0">
                <field name="name" />
                <field name="email" widget="email" />
                <field name="office" widget="many2many_tags" />
                <field name="perms_label" widget="badge"
                    decoration-success="perms_label == 'active'"
                    decoration-danger="perms_label == 'inactive'"
                    groups="upmin_iso.group_iso_staff" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.action_sync_unit_heads_server" model="ir.actions.server">
        <field name="name">Sync Unit Heads</field>
        <field name="model_id" ref="model_upmin_iso_unit_head" />
        <field name="state">code</field>
        <field name="code">action = model.action_sync_unit_heads()</field>
        <field name="groups_id" eval="[(4, ref('upmin_iso.group_iso_staff'))]" />
    </record>

    <record id="upmin_iso.unit_head_search" model="ir.ui.view">
        <field name="name">upmin_iso.unit_head.search</field>
        <field name="model">upmin_iso.unit_head</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="name" />
                <field name="office" />
            </search>
        </field>
    </record>

    <record id="upmin_iso.unit_head_action" model="ir.actions.act_window">
        <field name="name">Unit Heads</field>
        <field name="res_model">upmin_iso.unit_head</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"upmin_iso_dept_short": True}</field>
    </record>

</odoo>
