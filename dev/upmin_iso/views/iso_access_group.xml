<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.iso_access_group_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.iso_access_group.view.tree</field>
        <field name="model">upmin_iso.iso_access_group</field>
        <field name="arch" type="xml">
            <tree string="Access Groups">
                <field name="department_id" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.iso_access_group_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.iso_access_group.view.form</field>
        <field name="model">upmin_iso.iso_access_group</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="department_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.iso_access_group_action" model="ir.actions.act_window">
        <field name="name">Access Groups</field>
        <field name="res_model">upmin_iso.iso_access_group</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
