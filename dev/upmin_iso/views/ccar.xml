<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.ccar_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.ccar.view.form</field>
        <field name="model">upmin_iso.ccar</field>
        <field name="arch" type="xml">
            <form string="" delete="false">
                <sheet>
                    <group col="2">
                        <group col="1">
                            <field name="ccar_no" />
                        </group>
                        <group col="1">
                            <field name="date" />
                        </group>
                    </group>
                    <notebook>
                        <page name="nature" string="Nature">
                            <group col="5">
                                <group col="1">
                                    <field name="audit_nature" widget="radio" nolabel="1" />
                                </group>
                                <group col="1">
                                    <field name="conformity_nature" widget="radio" nolabel="1" />
                                </group>
                                <group col="1">
                                    <field name="complaint_nature_a" widget="radio" nolabel="1" />
                                    <br />
                                    <label for="internal_complaint_dept" />
                                    <br />
                                    <field name="internal_complaint_dept" nolabel="1" />
                                </group>
                                <group col="1">
                                    <field name="complaint_nature_b" widget="radio" nolabel="1" />
                                    <br />
                                    <label for="customer_complaint_customer" />
                                    <br />
                                    <field name="customer_complaint_customer" nolabel="1" />
                                </group>
                                <group col="1">
                                    <field name="complaint_nature_c" widget="radio" nolabel="1" />
                                    <br />
                                    <label for="supplier_nonconformity_supplier" />
                                    <br />
                                    <field name="supplier_nonconformity_supplier" nolabel="1" />
                                </group>
                            </group>
                        </page>
                        <page name="details" string="Details">

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.ccar_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.ccar.view.tree</field>
        <field name="model">upmin_iso.ccar</field>
        <field name="arch" type="xml">
            <tree string="" create="false" delete="false">
                <field name="ccar_no" />
                <field name="date" />
                <field name="audit_period" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.ccar_action" model="ir.actions.act_window">
        <field name="name">Correction and Corrective Action Report</field>
        <field name="res_model">upmin_iso.ccar</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>