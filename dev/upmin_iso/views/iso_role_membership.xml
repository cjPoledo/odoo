<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="iso_role_membership_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.role_membership.view.tree</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <tree string="ISO Roles" create="false" delete="false">
                <field name="name" />
                <field name="users" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record id="iso_role_membership_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.role_membership.view.form</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <form string="ISO Role" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="name" readonly="1" />
                        <field name="users" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="iso_role_membership_action" model="ir.actions.act_window">
        <field name="name">Manage ISO Roles</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('category_id.name', '=', 'UPMin ISO')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('iso_role_membership_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('iso_role_membership_view_form')})]" />
    </record>

</odoo>
