<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="significant_risks_export_wizard_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.significant_risks_export_wizard.view.form</field>
        <field name="model">upmin_iso.significant_risks_export_wizard</field>
        <field name="arch" type="xml">
            <form string="Export Significant Risks">
                <sheet>
                    <p>Exports all significant risks grouped by quarter, one sheet per quarter.</p>
                    <footer>
                        <button string="Export" name="action_export" type="object" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="significant_risks_export_wizard_action" model="ir.actions.act_window">
        <field name="name">Export Significant Risks</field>
        <field name="res_model">upmin_iso.significant_risks_export_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
