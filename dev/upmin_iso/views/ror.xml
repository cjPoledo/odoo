<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.ror_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.ror.view.form</field>
        <field name="model">upmin_iso.ror</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button string="Export to XLSX" type="object"
                            name="action_export_xlsx"
                            class="oe_stat_button" icon="fa-file-excel-o"
                            attrs="{'invisible': [('id', '=', False)]}" />
                        <button name="action_generate_quarter_ratings" type="object"
                            class="oe_stat_button" icon="fa-calendar-plus-o"
                            attrs="{'invisible': ['|', ('id', '=', False), ('pending_this_quarter', '=', 0)]}">
                            <field name="pending_this_quarter" widget="statinfo"
                                string="Pending This Quarter" />
                        </button>
                    </div>
                    <group>
                        <field name="office" attrs="{'readonly':[('id','!=', False)]}" />
                        <field name="related_swot" />
                    </group>
                    <div attrs="{'invisible': [('related_swot', '=', False)]}">
                        <button string="Import Issues from SWOT" name="action_import_from_swot"
                            type="object" class="btn-secondary mb-3" />
                    </div>
                    <group>
                        <field name="internal_issues" mode="tree,form"
                            context="{'form_view_ref': 'upmin_iso.swot_line_view_form_ror_direct'}">
                            <tree decoration-danger="fields_missing_count &gt; 0 or current_quarter_rated == 'no'">
                                <field name="description" />
                                <field name="fields_missing_count" invisible="1" />
                                <field name="fields_missing_label" string="Fields"
                                    widget="badge"
                                    decoration-danger="fields_missing_count &gt; 0" />
                                <field name="current_quarter_rated" string="This Quarter"
                                    widget="badge"
                                    decoration-success="current_quarter_rated == 'complete'"
                                    decoration-warning="current_quarter_rated == 'incomplete'"
                                    decoration-danger="current_quarter_rated == 'no'" />
                                <field name="ratings_status" string="Ratings Summary" />
                            </tree>
                        </field>
                        <field name="external_issues" mode="tree,form"
                            context="{'form_view_ref': 'upmin_iso.swot_line_view_form_ror_direct'}">
                            <tree decoration-danger="fields_missing_count &gt; 0 or current_quarter_rated == 'no'">
                                <field name="description" />
                                <field name="fields_missing_count" invisible="1" />
                                <field name="fields_missing_label" string="Fields"
                                    widget="badge"
                                    decoration-danger="fields_missing_count &gt; 0" />
                                <field name="current_quarter_rated" string="This Quarter"
                                    widget="badge"
                                    decoration-success="current_quarter_rated == 'complete'"
                                    decoration-warning="current_quarter_rated == 'incomplete'"
                                    decoration-danger="current_quarter_rated == 'no'" />
                                <field name="ratings_status" string="Ratings Summary" />
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="upmin_iso.swot_line_view_form_ror" model="ir.ui.view">
        <field name="name">upmin_iso.swot_line.view.form.ror</field>
        <field name="model">upmin_iso.swot_line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="1">
                        <field name="description" string="Issue" readonly="1"
                            help="What could affect the attainment of goals? Internal issues are Weaknesses in your SWOT. External issues are Threats in your SWOT" />
                        <field name="interested_parties" />
                        <field name="needs_and_exp" />
                        <field name="compliance" />
                    </group>
                    <notebook>
                        <page name="risk_consequence" string="Risks and Consequence">
                            <group>
                                <field name="risks" />
                                <field name="consequence" />
                                <field name="risk_existing_control" />
                            </group>
                        </page>
                        <page name="opportunities_benefit" string="Opportunities and Benefit">
                            <group>
                                <field name="opportunities" />
                                <field name="benefit" />
                                <field name="opportunities_existing_control" />
                            </group>
                        </page>
                    </notebook>
                    <group col="1">
                        <field name="ratings">
                            <tree>
                                <field name="review_date" />
                                <field name="risk_conclusion" />
                                <field name="opportunity_conclusion" />
                                <field name="progress" widget="progressbar" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.swot_line_view_form_ror_direct" model="ir.ui.view">
        <field name="name">upmin_iso.swot_line.view.form.ror.direct</field>
        <field name="model">upmin_iso.swot_line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="1">
                        <field name="description" string="Issue"
                            help="Describe the internal/external issue." />
                        <field name="interested_parties" />
                        <field name="needs_and_exp" />
                        <field name="compliance" />
                    </group>
                    <notebook>
                        <page name="risk_consequence" string="Risks and Consequence">
                            <group>
                                <field name="risks" />
                                <field name="consequence" />
                                <field name="risk_existing_control" />
                            </group>
                        </page>
                        <page name="opportunities_benefit" string="Opportunities and Benefit">
                            <group>
                                <field name="opportunities" />
                                <field name="benefit" />
                                <field name="opportunities_existing_control" />
                            </group>
                        </page>
                    </notebook>
                    <group col="1">
                        <field name="ratings">
                            <tree>
                                <field name="review_date" />
                                <field name="risk_conclusion" />
                                <field name="opportunity_conclusion" />
                                <field name="progress" widget="progressbar" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.ror_rating_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.ror_rating.view.form</field>
        <field name="model">upmin_iso.ror_rating</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <field name="progress" widget="progressbar" />
                    </div>
                    <group col="2">
                        <group>
                            <field name="issue_description" string="Issue" readonly="1" />
                        </group>
                        <group>
                            <field name="review_date" />
                        </group>
                    </group>
                    <notebook>
                        <page name="risk_rating" string="Risk Rating">
                            <group string="Reference (from Issue)">
                                <field name="risks" readonly="1" />
                                <field name="consequence" readonly="1" />
                                <field name="risk_existing_control" readonly="1" />
                            </group>
                            <group string="Rating">
                                <field name="risk_likelihood" />
                                <field name="risk_frequency" />
                                <field name="consequence_severity" />
                                <field name="risk_rating" />
                                <field name="risk_conclusion" widget="badge"
                                    decoration-danger="risk_conclusion == 'significant'"
                                    decoration-success="risk_conclusion == 'not significant'" />
                            </group>
                            <group string="Action">
                                <field name="risk_required_action" />
                                <field name="risk_responsible" />
                                <field name="risk_due_date" />
                                <field name="risk_status" />
                            </group>
                        </page>
                        <page name="opportunity_rating" string="Opportunity Rating">
                            <group string="Reference (from Issue)">
                                <field name="opportunities" readonly="1" />
                                <field name="benefit" readonly="1" />
                                <field name="opportunities_existing_control" readonly="1" />
                            </group>
                            <group string="Rating">
                                <field name="opportunity_likelihood" />
                                <field name="opportunity_frequency" />
                                <field name="benefit_severity" />
                                <field name="opportunity_rating" />
                                <field name="opportunity_conclusion" widget="badge"
                                    decoration-danger="opportunity_conclusion == 'significant'"
                                    decoration-success="opportunity_conclusion == 'not significant'" />
                            </group>
                            <group string="Action">
                                <field name="opportunity_required_action" />
                                <field name="opportunity_responsible" />
                                <field name="opportunity_due_date" />
                                <field name="opportunity_status" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.ror_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.ror.view.tree</field>
        <field name="model">upmin_iso.ror</field>
        <field name="arch" type="xml">
            <tree string="" decoration-warning="pending_this_quarter &gt; 0">
                <field name="office" />
                <field name="related_swot" />
                <field name="pending_this_quarter" string="Pending This Quarter" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.ror_search" model="ir.ui.view">
        <field name="name">upmin_iso.ror.search</field>
        <field name="model">upmin_iso.ror</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="office" />
                <group expand="1" string="Group By">
                    <filter name="group_by_office" string="Office" context="{'group_by': 'office'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.ror_action" model="ir.actions.act_window">
        <field name="name">Risk and Opportunities Register</field>
        <field name="res_model">upmin_iso.ror</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"upmin_iso_dept_short": True}</field>
    </record>

    <record id="upmin_iso.significant_risks_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.significant_risks.view.tree</field>
        <field name="model">upmin_iso.ror_rating</field>
        <field name="arch" type="xml">
            <tree string="Significant Risks" create="false" edit="false" delete="false">
                <field name="review_date" />
                <field name="office_name" />
                <field name="issue_description" />
                <field name="risk_rating" />
                <field name="risk_required_action" />
                <field name="risk_responsible" />
                <field name="risk_due_date" />
                <field name="risk_status" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.significant_risks_search" model="ir.ui.view">
        <field name="name">upmin_iso.significant_risks.search</field>
        <field name="model">upmin_iso.ror_rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="office_name" string="Office" />
                <field name="issue_description" string="Issue" />
                <group expand="1" string="Group By">
                    <filter name="group_by_review_date" string="Quarter" context="{'group_by': 'review_date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.ror_rating_view_form_readonly" model="ir.ui.view">
        <field name="name">upmin_iso.ror_rating.view.form.readonly</field>
        <field name="model">upmin_iso.ror_rating</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="upmin_iso.ror_rating_view_form" />
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="edit">false</attribute>
                <attribute name="delete">false</attribute>
            </form>
        </field>
    </record>

    <record id="upmin_iso.significant_risks_action" model="ir.actions.act_window">
        <field name="name">Significant Risks (Quarterly)</field>
        <field name="res_model">upmin_iso.ror_rating</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5,), (0, 0, {'view_mode': 'tree', 'view_id': ref('upmin_iso.significant_risks_view_tree'), 'sequence': 1}), (0, 0, {'view_mode': 'form', 'view_id': ref('upmin_iso.ror_rating_view_form_readonly'), 'sequence': 2})]" />
        <field name="domain">[('risk_conclusion', '=', 'significant')]</field>
        <field name="context">{"search_default_group_by_review_date": 1, "upmin_iso_dept_short": True}</field>
        <field name="search_view_id" ref="upmin_iso.significant_risks_search" />
    </record>


</odoo>