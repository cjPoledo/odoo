<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.iso_clause_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.iso_clause.view.form</field>
        <field name="model">upmin_iso.iso_clause</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="clause_number" />
                        <field name="clause_title" />
                        <field name="clause_description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.iso_clause_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.iso_clause.view.tree</field>
        <field name="model">upmin_iso.iso_clause</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="clause_number" />
                <field name="clause_title" />
                <field name="clause_description" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.iso_clause_view_search" model="ir.ui.view">
        <field name="name">upmin_iso.iso_clause.view.search</field>
        <field name="model">upmin_iso.iso_clause</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="clause_number" />
                <field name="clause_title" />
                <field name="clause_description" />
            </search>
        </field>
    </record>

    <record id="upmin_iso.iso_clause_action" model="ir.actions.act_window">
        <field name="name">ISO Clauses</field>
        <field name="res_model">upmin_iso.iso_clause</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>