<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.internal_auditor_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.internal_auditor.view.form</field>
        <field name="model">upmin_iso.internal_auditor</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="office" />
                        <field name="trained" />
                        <field name="certified" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.internal_auditor_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.internal_auditor.view.tree</field>
        <field name="model">upmin_iso.internal_auditor</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name" />
                <field name="office" />
                <field name="trained" />
                <field name="certified" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.internal_auditor_action" model="ir.actions.act_window">
        <field name="name">Internal Auditors</field>
        <field name="res_model">upmin_iso.internal_auditor</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>