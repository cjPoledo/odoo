<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.internal_auditor_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.internal_auditor.view.form</field>
        <field name="model">upmin_iso.internal_auditor</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="email" widget="email" />
                        <field name="office" />
                        <field name="trained" />
                        <field name="certified" />
                        <field name="perms_label" widget="badge"
                            decoration-success="perms_label == 'active'"
                            decoration-danger="perms_label == 'inactive'"
                            groups="upmin_iso.group_iso_staff" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.internal_auditor_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.internal_auditor.view.tree</field>
        <field name="model">upmin_iso.internal_auditor</field>
        <field name="arch" type="xml">
            <tree string=""
                decoration-muted="not trained"
                decoration-success="certified">
                <field name="name" />
                <field name="email" widget="email" />
                <field name="office" />
                <field name="trained" />
                <field name="certified" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.internal_auditor_search" model="ir.ui.view">
        <field name="name">upmin_iso.internal_auditor.search</field>
        <field name="model">upmin_iso.internal_auditor</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="name" />
                <field name="office" />
                <separator />
                <filter name="filter_trained" string="Trained"
                    domain="[('trained', '=', True)]" />
                <filter name="filter_certified" string="Certified"
                    domain="[('certified', '=', True)]" />
                <group expand="1" string="Group By">
                    <filter name="group_by_office" string="Office"
                        context="{'group_by': 'office'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.internal_auditor_action" model="ir.actions.act_window">
        <field name="name">Internal Auditors</field>
        <field name="res_model">upmin_iso.internal_auditor</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>