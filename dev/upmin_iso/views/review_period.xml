<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.review_period_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.review_period.view.form</field>
        <field name="model">upmin_iso.review_period</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="review_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.review_period_view_search" model="ir.ui.view">
        <field name="name">upmin_iso.review_period.view.search</field>
        <field name="model">upmin_iso.review_period</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="review_date" />
            </search>
        </field>
    </record>

    <record id="upmin_iso.review_period_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.review_period.view.tree</field>
        <field name="model">upmin_iso.review_period</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="review_date" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.review_period_action" model="ir.actions.act_window">
        <field name="name">Review Period</field>
        <field name="res_model">upmin_iso.review_period</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>