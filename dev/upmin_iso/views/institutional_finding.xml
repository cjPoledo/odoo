<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.institutional_finding_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.institutional_finding.view.form</field>
        <field name="model">upmin_iso.institutional_finding</field>
        <field name="arch" type="xml">
            <form string="" create="false">
                <sheet>
                    <group col="2">
                        <group col="1">
                            <field name="clause" />
                        </group>
                        <group col="1">
                            <field name="audit_period" options="{'no_open': True}" />
                        </group>
                    </group>
                    <group col="2">
                        <group col="1">
                            <field name="supporting_clause_ids" widget="many2many_tags"
                                options="{'no_create': True}" />
                        </group>
                        <group col="1">
                            <field name="finding_count" />
                        </group>
                    </group>
                    <group col="1">
                        <field name="description" />
                    </group>
                    <div class="mt-3">
                        <label for="office_display" string="Offices" class="o_form_label fw-bold mb-2 d-block" />
                        <field name="office_display" nolabel="1" readonly="1" />
                    </div>
                    <div class="mt-3">
                        <label for="finding_ids" string="Member Findings" class="o_form_label fw-bold mb-2 d-block" />
                        <field name="finding_ids" nolabel="1" readonly="1">
                            <tree create="false" delete="false">
                                <field name="related_office_name" string="Office" />
                                <field name="clause_display" />
                                <field name="evidence" />
                                <field name="statement" />
                                <button name="action_remove_from_institutional_finding"
                                    type="object" string="Ungroup" icon="fa-times"
                                    confirm="Remove this finding from the institutional finding? It will count as its own individual NC again." />
                            </tree>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.institutional_finding_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.institutional_finding.view.tree</field>
        <field name="model">upmin_iso.institutional_finding</field>
        <field name="arch" type="xml">
            <tree string="" create="false">
                <field name="audit_period" />
                <field name="clause" />
                <field name="finding_count" />
                <field name="office_display" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.institutional_finding_search" model="ir.ui.view">
        <field name="name">upmin_iso.institutional_finding.search</field>
        <field name="model">upmin_iso.institutional_finding</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="audit_period" />
                <field name="clause" />
                <group expand="1" string="Group By">
                    <filter name="group_by_audit_period" string="Audit Period"
                        context="{'group_by': 'audit_period'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.institutional_finding_action" model="ir.actions.act_window">
        <field name="name">Institutional Findings</field>
        <field name="res_model">upmin_iso.institutional_finding</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_group_by_audit_period": 1}</field>
    </record>

</odoo>
