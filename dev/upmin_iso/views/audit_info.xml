<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.audit_info_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.audit_info.view.form</field>
        <field name="model">upmin_iso.audit_info</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <field name="is_staff" invisible="1" />
                    <field name="is_office_auditor" invisible="1" />
                    <field name="is_finalized" invisible="1" />
                    <group col="2">
                        <group>
                            <field name="office_to_audit"
                                attrs="{'readonly': ['|', ('is_finalized','=',True), ('is_staff','=',False)]}" />
                        </group>
                        <group>
                            <field name="audit_period"
                                attrs="{'readonly': ['|', ('is_finalized','=',True), ('is_staff','=',False)]}" />
                        </group>
                    </group>
                    <group col="1">
                        <field name="internal_auditors"
                            options="{'no_create': True, 'no_open': True}"
                            widget="many2many_tags_avatar"
                            attrs="{'readonly': ['|', ('is_finalized','=',True), ('is_staff','=',False)]}" />
                        <field name="audit_date"
                            attrs="{'readonly': ['|', ('is_finalized','=',True), '&amp;', ('is_office_auditor','=',False), ('is_staff','=',False)]}" />
                    </group>
                    <group col="2">
                        <group>
                            <field name="audit_time_start" widget="float_time"
                                attrs="{'readonly': ['|', ('is_finalized','=',True), '&amp;', ('is_office_auditor','=',False), ('is_staff','=',False)]}" />
                        </group>
                        <group>
                            <field name="audit_time_end" widget="float_time"
                                attrs="{'readonly': ['|', ('is_finalized','=',True), '&amp;', ('is_office_auditor','=',False), ('is_staff','=',False)]}" />
                        </group>
                    </group>
                    <group col="3">
                        <group>
                            <field name="c" decoration-success="True" />
                        </group>
                        <group>
                            <field name="nc" decoration-danger="True" />
                        </group>
                        <group>
                            <field name="ofi" decoration-warning="True" />
                        </group>
                    </group>
                    <group col="1">
                        <field name="audit_findings"
                            attrs="{'readonly': ['|', ('is_finalized','=',True), ('is_office_auditor','=',False)]}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.audit_info_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.audit_info.view.tree</field>
        <field name="model">upmin_iso.audit_info</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="office_to_audit" />
                <field name="audit_period" />
                <field name="internal_auditors" />
                <field name="audit_date" />
                <field name="audit_time_start" widget="float_time" />
                <field name="audit_time_end" widget="float_time" />
                <field name="c" decoration-success="True" />
                <field name="nc" decoration-danger="True" />
                <field name="ofi" decoration-warning="True" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.audit_finding_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.audit_finding.view.form</field>
        <field name="model">upmin_iso.audit_finding</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="1">
                        <field name="auditor" />
                        <field name="clause" />
                        <field name="question" />
                        <field name="evidence" />
                        <field name="rating" widget="radio" />
                        <field name="statement" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.audit_finding_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.audit_finding.view.tree</field>
        <field name="model">upmin_iso.audit_finding</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="auditor" />
                <field name="clause" />
                <field name="rating" widget="badge"
                    decoration-success="rating == 'c'"
                    decoration-danger="rating == 'nc'"
                    decoration-warning="rating == 'ofi'" />
                <field name="question" optional="show" />
                <field name="evidence" optional="hide" />
                <field name="statement" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.audit_info_view_search" model="ir.ui.view">
        <field name="name">upmin_iso.audit_info.view.search</field>
        <field name="model">upmin_iso.audit_info</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="office_to_audit" />
                <field name="audit_period" />
                <separator />
                <filter name="filter_finalized" string="Finalized"
                    domain="[('is_finalized', '=', True)]" />
                <filter name="filter_not_finalized" string="Not Finalized"
                    domain="[('is_finalized', '=', False)]" />
                <group expand="1" string="Group By">
                    <filter name="group_by_audit_period" string="Audit Period"
                        context="{'group_by': 'audit_period'}" />
                    <filter name="group_by_office" string="Office"
                        context="{'group_by': 'office_to_audit'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.audit_info_action" model="ir.actions.act_window">
        <field name="name">Internal Audit</field>
        <field name="res_model">upmin_iso.audit_info</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_group_by_audit_period": 1}</field>
    </record>

</odoo>