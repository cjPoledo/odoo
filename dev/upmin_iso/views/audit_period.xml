<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.audit_period_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.audit_period.view.form</field>
        <field name="model">upmin_iso.audit_period</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="action_finalize" string="Finalize" type="object"
                        attrs="{'invisible': [('is_finalized', '=', True)]}" class="btn-primary"
                        confirm="Finalize this audit period? This will lock all audit schedules and findings." />
                    <button name="action_unfinalize" string="Unfinalize" type="object"
                        attrs="{'invisible': ['|', ('is_finalized', '=', False), ('ccars', '!=', [])]}"
                        class="btn-secondary"
                        confirm="Unfinalize this audit period? Audit schedules and findings will become editable again." />
                    <button name="action_generate_ccar" string="GENERATE CCAR" type="object"
                        attrs="{'invisible': ['|', '|', ('is_finalized', '=', False), ('ccars', '!=', []), ('related_nc', '=', [])]}"
                        class="btn-primary"
                        confirm="Generate CCARs for all Non-Conformities in this period? This action will create CCAR records for each NC finding." />
                    <button name="action_undo_generate_ccar" string="UNDO CCAR GENERATION"
                        type="object"
                        attrs="{'invisible': ['|', ('is_finalized', '=', False), ('ccars', '=', [])]}"
                        class="btn-secondary"
                        confirm="Delete all generated CCARs for this period? This cannot be undone." />
                    <button name="action_open_institutional_finding_wizard"
                        string="GROUP INTO INSTITUTIONAL FINDING" type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('related_nc', '=', [])]}"
                        groups="upmin_iso.group_iso_staff" />
                    <field name="is_finalized" invisible="1" />
                </header>
                <sheet>
                    <group col="2">
                        <group>
                            <field name="audit_start_date" widget="daterange"
                                options="{'related_end_date': 'audit_end_date'}"
                                attrs="{'readonly': [('is_finalized', '=', True)]}" />
                        </group>
                        <group>
                            <field name="audit_end_date" widget="daterange"
                                options="{'related_start_date': 'audit_start_date'}"
                                attrs="{'readonly': [('is_finalized', '=', True)]}" />
                        </group>
                    </group>
                    <div class="mt-3">
                        <label for="final_nc_ids" string="Final Nonconformities" class="o_form_label fw-bold mb-2 d-block" />
                        <field name="final_nc_count" class="fw-bold ms-2" />
                        <field name="final_nc_ids" nolabel="1">
                            <tree string="" create="false" edit="false" delete="false"
                                decoration-info="kind == 'institutional'">
                                <field name="kind" widget="badge"
                                    decoration-info="kind == 'institutional'"
                                    decoration-muted="kind == 'individual'" />
                                <field name="clause_display" />
                                <field name="office_display" />
                                <button name="action_open_record" type="object"
                                    string="Open" icon="fa-external-link" />
                            </tree>
                        </field>
                    </div>
                    <div class="mt-3">
                        <label for="related_nc" string="Nonconformities (Detail)" class="o_form_label fw-bold mb-2 d-block" />
                        <field name="related_nc" nolabel="1">
                            <tree string="">
                                <field name="related_office_name" string="Office" />
                                <field name="clause_display" />
                                <field name="question" />
                                <field name="evidence" />
                                <field name="statement" />
                                <field name="institutional_finding_id" widget="badge"
                                    string="Institutional Finding" />
                            </tree>
                        </field>
                    </div>
                    <div class="mt-3">
                        <label for="institutional_findings" string="Institutional Findings" class="o_form_label fw-bold mb-2 d-block" />
                        <field name="institutional_findings" nolabel="1">
                            <tree string="">
                                <field name="clause" />
                                <field name="finding_count" />
                                <field name="office_display" />
                            </tree>
                        </field>
                    </div>
                    <div class="mt-3">
                        <label for="ccars" string="Issued CCARs" class="o_form_label fw-bold mb-2 d-block" />
                        <field name="ccars" nolabel="1" />
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.audit_period_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.audit_period.view.tree</field>
        <field name="model">upmin_iso.audit_period</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="audit_start_date" />
                <field name="audit_end_date" />
                <field name="related_c" />
                <field name="related_nc" />
                <field name="related_ofi" />
                <field name="is_finalized" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.audit_period_view_search" model="ir.ui.view">
        <field name="name">upmin_iso.audit_period.view.search</field>
        <field name="model">upmin_iso.audit_period</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="audit_start_date" />
                <field name="audit_end_date" />
                <separator />
                <filter name="filter_not_finalized" string="Not Finalized"
                    domain="[('is_finalized', '=', False)]" />
                <filter name="filter_finalized" string="Finalized"
                    domain="[('is_finalized', '=', True)]" />
            </search>
        </field>
    </record>

    <record id="upmin_iso.audit_period_action" model="ir.actions.act_window">
        <field name="name">Audit Period</field>
        <field name="res_model">upmin_iso.audit_period</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_filter_not_finalized": 1, "upmin_iso_dept_short": True}</field>
    </record>

</odoo>