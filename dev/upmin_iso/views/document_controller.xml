<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.document_controller_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.document_controller.view.form</field>
        <field name="model">upmin_iso.document_controller</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="email" widget="email" />
                        <field name="office" />
                        <field name="trained" />
                        <field name="is_unit_head" groups="upmin_iso.group_iso_staff" />
                        <field name="perms_label" widget="badge"
                            decoration-success="perms_label == 'active'"
                            decoration-danger="perms_label == 'inactive'"
                            groups="upmin_iso.group_iso_staff" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.document_controller_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.document_controller.view.tree</field>
        <field name="model">upmin_iso.document_controller</field>
        <field name="arch" type="xml">
            <tree string=""
                decoration-muted="not trained">
                <field name="name" />
                <field name="email" widget="email" />
                <field name="office" />
                <field name="trained" />
                <field name="is_unit_head" groups="upmin_iso.group_iso_staff" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.document_controller_action" model="ir.actions.act_window">
        <field name="name">Document Controllers</field>
        <field name="res_model">upmin_iso.document_controller</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
