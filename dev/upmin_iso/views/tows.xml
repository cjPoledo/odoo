<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upmin_iso.tows_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.tows.view.tree</field>
        <field name="model">upmin_iso.tows</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="year" />
                <field name="office" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.tows_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.tows.view.form</field>
        <field name="model">upmin_iso.tows</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button string="Export SWOT / TOWS" name="action_export_swot_tows"
                        type="object" class="btn-secondary"
                        attrs="{'invisible': [('id', '=', False)]}" />
                </header>
                <sheet>
                    <group col="2">
                        <group col="1" colspan="2">
                            <field name="swot" attrs="{'readonly': [('id', '!=', False)]}" />
                        </group>
                        <group col="1">
                            <field name="year" />
                        </group>
                        <group col="1">
                            <field name="office" />
                        </group>
                    </group>
                    <group string="Additional Viewers" attrs="{'invisible': [('id', '=', False)]}"
                           groups="upmin_iso.group_iso_staff">
                        <field name="bypass_user_ids" widget="many2many_tags_avatar" nolabel="1" colspan="2" />
                    </group>
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('id','!=',False)]}">
                        <strong>How to use TOWS:</strong> Select a SWOT above and save first, then add strategies below by matching quadrant pairs.
                        SO — use strengths to exploit opportunities.
                        ST — use strengths to minimise threats.
                        WO — exploit opportunities to overcome weaknesses.
                        WT — reduce weaknesses to avoid threats.
                        Matches don't need to be sequential (e.g. S1 can match O3).
                    </div>
                    <group col="2" attrs="{'invisible': [('id','=',False)]}">
                        <group string="SO — Strengths × Opportunities">
                            <field name="so" nolabel="1" colspan="2">
                                <tree>
                                    <field name="related_swot_line_ids" widget="many2many_tags" />
                                    <field name="description" string="Strategy" />
                                </tree>
                            </field>
                        </group>
                        <group string="WO — Weaknesses × Opportunities">
                            <field name="wo" nolabel="1" colspan="2">
                                <tree>
                                    <field name="related_swot_line_ids" widget="many2many_tags" />
                                    <field name="description" string="Strategy" />
                                </tree>
                            </field>
                        </group>
                        <group string="ST — Strengths × Threats">
                            <field name="st" nolabel="1" colspan="2">
                                <tree>
                                    <field name="related_swot_line_ids" widget="many2many_tags" />
                                    <field name="description" string="Strategy" />
                                </tree>
                            </field>
                        </group>
                        <group string="WT — Weaknesses × Threats">
                            <field name="wt" nolabel="1" colspan="2">
                                <tree>
                                    <field name="related_swot_line_ids" widget="many2many_tags" />
                                    <field name="description" string="Strategy" />
                                </tree>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.tows_line_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.tows_line.view.form</field>
        <field name="model">upmin_iso.tows_line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="1">
                        <field name="allowed_swot_line_ids" invisible="1" />
                        <field name="related_swot_line_ids" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.tows_search" model="ir.ui.view">
        <field name="name">upmin_iso.tows.search</field>
        <field name="model">upmin_iso.tows</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="year" />
                <field name="office" />
                <group expand="1" string="Group By">
                    <filter name="group_by_year" string="Year" context="{'group_by': 'year'}" />
                    <filter name="group_by_office" string="Office" context="{'group_by': 'office'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.tows_action" model="ir.actions.act_window">
        <field name="name">TOWS Analysis</field>
        <field name="res_model">upmin_iso.tows</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_group_by_year": 1, "upmin_iso_dept_short": True}</field>
    </record>

</odoo>