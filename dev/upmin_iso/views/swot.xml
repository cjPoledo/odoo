    </record>

    <record id="upmin_iso.swot_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.swot.view.tree</field>
        <field name="model">upmin_iso.swot</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="year" />
                <field name="office" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.swot_line_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.swot_line.view.form</field>
        <field name="model">upmin_iso.swot_line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="2">
                        <group col="1">
                            <field name="label" />
                        </group>
                        <group col="1">
                            <field name="swot_type" />
                        </group>
                        <group col="1" colspan="2">
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.swot_action" model="ir.actions.act_window">
        <field name="name">SWOT</field>
        <field name="res_model">upmin_iso.swot</field>
        <field name="view_mode">tree,form</field>
    </record>

