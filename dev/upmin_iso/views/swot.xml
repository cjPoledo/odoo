<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upmin_iso.swot_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.swot.view.form</field>
        <field name="model">upmin_iso.swot</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="2">
                        <group col="1">
                            <field name="year" />
                        </group>
                        <group col="1">
                            <field name="office" />
                        </group>
                    </group>
                    <group col="2">
                        <group string="Strengths">
                            <field name="strengths" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="label" />
                                    <field name="description" string="Strength" />
                                </tree>
                            </field>
                        </group>
                        <group string="Weaknesses">
                            <field name="weaknesses" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="label" />
                                    <field name="description" string="Weakness" />
                                </tree>
                            </field>
                        </group>
                        <group string="Opportunities">
                            <field name="opportunities" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="label" />
                                    <field name="description" string="Opportunity" />
                                </tree>
                            </field>
                        </group>
                        <group string="Threats">
                            <field name="threats" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="label" />
                                    <field name="description" string="Threat" />
                                </tree>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.swot_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.swot.view.tree</field>
        <field name="model">upmin_iso.swot</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="year" />
                <field name="office" />
                <field name="strengths_count" string="S" />
                <field name="weaknesses_count" string="W" />
                <field name="opportunities_count" string="O" />
                <field name="threats_count" string="T" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.swot_line_view_form" model="ir.ui.view">
        <field name="name">upmin_iso.swot_line.view.form</field>
        <field name="model">upmin_iso.swot_line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="2">
                        <group col="1">
                            <field name="label" />
                        </group>
                        <group col="1">
                            <field name="swot_type" />
                        </group>
                        <group col="1" colspan="2">
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upmin_iso.swot_line_view_tree" model="ir.ui.view">
        <field name="name">upmin_iso.swot_line.view.tree</field>
        <field name="model">upmin_iso.swot_line</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="label" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="upmin_iso.swot_search" model="ir.ui.view">
        <field name="name">upmin_iso.swot.search</field>
        <field name="model">upmin_iso.swot</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="year" />
                <field name="office" />
                <group expand="1" string="Group By">
                    <filter name="group_by_year" string="Year" context="{'group_by': 'year'}" />
                    <filter name="group_by_office" string="Office" context="{'group_by': 'office'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="upmin_iso.swot_action" model="ir.actions.act_window">
        <field name="name">SWOT Analysis</field>
        <field name="res_model">upmin_iso.swot</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_group_by_year": 1}</field>
    </record>

</odoo>